# ColourPix Backend Configuration Environment Variables

# The port the server runs on
PORT=5000

# Database connectivity properties
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=colourpix_db
DB_PORT=3306

# CORS Allowed Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=https://colourpix.pk,https://www.colourpix.pk

# JWT Encryption Secret
JWT_SECRET=supersecretjwtkeyforprod
